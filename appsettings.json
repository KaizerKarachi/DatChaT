{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=familychat;Username=postgres;Password=postgres"
  },
  "SignalR": {
    "KeepAliveIntervalSeconds": 15,
    "ClientTimeoutSeconds": 30,
    "MaxMessageSizeKB": 32
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "FileUpload": {
    "MaxSizeMB": 10,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".pdf", ".doc", ".docx", ".txt"]
  },
  "Features": {
    "EnablePrivateMessages": true,
    "EnableFileSharing": true,
    "EnablePinnedMessages": true,
    "EnableSearch": true
  }
}
