/* ===========================
   DatChaT Chat
=========================== */

.messages{

    display:flex;

    flex-direction:column;

    gap:18px;

    padding:24px;

    overflow-y:auto;

}

/* ---------- Message ---------- */

.message{

    display:flex;

    flex-direction:column;

    max-width:72%;

    animation:messageAppear .18s ease;

}

.message.left{

    align-self:flex-start;

}

.message.right{

    align-self:flex-end;

}

.message-user{

    font-size:13px;

    color:#6b8f4e;

    font-weight:600;

    margin-bottom:4px;

}

.message.right .message-user{

    display:none;

}

.bubble{

    padding:14px 18px;

    border-radius:18px;

    line-height:1.5;

    word-break:break-word;

    position:relative;

}

.left .bubble{

    background:#ffffff;

    color:#2f3437;

}

.right .bubble{

    background:#6b8f4e;

    color:white;

}

.message-time{

    margin-top:5px;

    font-size:11px;

    opacity:.65;

    text-align:right;

}

/* ---------- Hover ---------- */

.message:hover .bubble{

    transform:translateY(-1px);

    box-shadow:0 8px 20px rgba(0,0,0,.08);

}

/* ---------- Pinned ---------- */

.pinned{

    display:flex;

    align-items:center;

    gap:12px;

    padding:14px 20px;

    background:#fff8d6;

    border-bottom:1px solid #e7d89f;

}

.pinned span:first-child{

    font-size:22px;

}

/* ---------- Composer ---------- */

.composer{

    display:grid;

    grid-template-columns:52px 1fr 52px 64px;

    gap:10px;

    align-items:center;

}

.composer button{

    height:48px;

    border:none;

    border-radius:12px;

    cursor:pointer;

}

#messageInput{

    height:48px;

    border-radius:12px;

    padding:0 16px;

    font-size:15px;

}

#messageInput::placeholder{

    color:#999;

}

/* ---------- Send ---------- */

#sendBtn{

    font-size:22px;

    font-weight:bold;

}

/* ---------- Users ---------- */

.user{

    display:flex;

    align-items:center;

    gap:12px;

    padding:12px;

}

.user-name{

    font-weight:600;

}

.user-status{

    font-size:12px;

    color:#cdddc8;

}

/* ---------- Animation ---------- */

@keyframes messageAppear{

    from{

        opacity:0;

        transform:translateY(8px);

    }

    to{

        opacity:1;

        transform:none;

    }

}


/* ==================================================
   DatChaT — composer и сообщения
   ================================================== */

.chat {
    position: relative;
    min-height: 0;
    height: 100vh;
    overflow: hidden;
}

.messages {
    position: absolute;
    top: 96px;
    right: 0;
    bottom: 82px;
    left: 0;

    display: flex;
    flex-direction: column;

    gap: 12px;
    padding: 20px 28px;

    overflow-y: auto;
    box-sizing: border-box;
}

/* Поле ввода всегда снизу */

.composer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;

    height: 82px;
    box-sizing: border-box;

    display: grid;
    grid-template-columns: 48px 1fr 48px 56px;
    gap: 10px;

    padding: 14px 20px;

    z-index: 20;
}

/* Кнопки composer */

.composer button {
    width: 48px;
    height: 48px;
    padding: 0;

    border: none;
    border-radius: 50%;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 20px;
}

#messageInput {
    width: 100%;
    height: 48px;
    box-sizing: border-box;

    border-radius: 24px;
    padding: 0 18px;

    outline: none;
}

#messageInput:focus {
    border-color: #8b5cf6;
    box-shadow: 0 0 0 3px rgba(139, 92, 246, .15);
}

/* Фиолетовая круглая кнопка отправки */

#sendBtn {
    width: 52px;
    height: 52px;

    border-radius: 50%;

    background: #8b5cf6;
    color: white;

    font-size: 22px;
    font-weight: bold;

    box-shadow: 0 5px 15px rgba(139, 92, 246, .30);

    transition:
        transform .15s ease,
        box-shadow .15s ease;
}

#sendBtn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(139, 92, 246, .40);
}

#sendBtn:active {
    transform: scale(.94);
}

/* История сообщений */

.message {
    max-width: 72%;
    align-self: flex-start;
}

.message.mine {
    align-self: flex-end;
}

.message-header {
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 4px;
    color: #71805f;
}

.message-body {
    padding: 11px 15px;
    border-radius: 16px;

    background: #ffffff;
    color: #252525;

    word-break: break-word;
}

.message.mine .message-body {
    background: #8b5cf6;
    color: white;
}

.message-footer {
    margin-top: 4px;
    font-size: 10px;
    opacity: .55;
    text-align: right;
}

/* Тёмная тема */

body.dark-theme .message-body {
    background: #302b3d;
    color: #f4f1fa;
}

body.dark-theme .message.mine .message-body {
    background: #8b5cf6;
    color: white;
}
