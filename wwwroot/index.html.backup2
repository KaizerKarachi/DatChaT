<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>DatCha</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <style>
        :root {
            --bg-gradient: linear-gradient(180deg, #87CEEB 0%, #98D8C8 50%, #7BC67E 100%);
            --container-bg: rgba(255, 255, 255, 0.95);
            --header-bg: rgba(255, 255, 255, 0.1);
            --header-text-color: #2d5016;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
            background: var(--bg-gradient); 
            height: 100vh; 
            display: flex; 
            align-items: center; 
            justify-content: center;
            position: relative; 
            overflow: hidden; 
        }
        .container { 
            width: 100%; 
            max-width: 800px; 
            height: 90vh; 
            background: var(--container-bg); 
            backdrop-filter: blur(10px);
            display: flex; 
            flex-direction: column; 
            overflow: hidden; 
            position: relative; 
            z-index: 3;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            border-radius: 20px;
            margin: 20px auto;
        }
        .header { 
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border-bottom: 2px solid #2d5016;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            color: white; 
            padding: 15px; 
            text-align: center; 
            font-size: 20px; 
            font-weight: bold; 
            flex-shrink: 0; 
            position: relative; 
            overflow: hidden; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
        }
        .header-text { 
            font-size: 28px;
            font-weight: 800;
            background: linear-gradient(135deg, #2d5016 0%, #4a7c2e 50%, #2d5016 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -0.5px;
            position: relative;
            z-index: 1;
        }
        .logout-btn, .theme-toggle { 
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.5);
            transition: all 0.3s ease;
            color: white;
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 14px;
            cursor: pointer;
        }
        .logout-btn:hover, .theme-toggle:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }
        .logout-btn.show { display: block; }
        .login-screen { 
            flex: 1; 
            display: flex; 
            flex-direction: column; 
            justify-content: center; 
            align-items: center; 
            padding: 20px; 
        }
        .login-screen h2 { margin-bottom: 10px; color: #333; font-size: 24px; }
        .login-screen p { color: #999; margin-bottom: 30px; text-align: center; }
        .login-screen input { 
            padding: 15px 20px; 
            font-size: 16px; 
            border: 2px solid #ddd; 
            border-radius: 10px; 
            margin-bottom: 15px; 
            width: 100%; 
            max-width: 300px; 
        }
        .login-screen input:focus { outline: none; border-color: #2d5016; }
        .login-screen button { 
            padding: 15px 40px; 
            font-size: 16px; 
            background: linear-gradient(135deg, #8B7FB8 0%, #9B8FC8 100%); 
            color: white; 
            border: none; 
            border-radius: 10px; 
            cursor: pointer; 
        }
        .main { 
            flex: 1; 
            display: flex; 
            overflow: hidden; 
            flex-direction: column; 
        }
        .users-panel { 
            width: 200px; 
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(15px);
            border-right: 1px solid rgba(45, 80, 22, 0.1);
            padding: 20px; 
            overflow-y: auto; 
            flex-shrink: 0; 
        }
        .users-panel h3 { font-size: 14px; color: #666; margin-bottom: 10px; }
        .user-item { 
            padding: 8px 12px; 
            margin-bottom: 5px; 
            background: rgba(255, 255, 255, 0.6);
            border-radius: 8px; 
            font-size: 14px; 
            color: #333;
        }
        .messages { 
            flex: 1; 
            overflow-y: auto; 
            padding: 15px; 
            background: transparent;
        }
        .message { 
            margin-bottom: 12px; 
            animation: slideIn 0.3s ease; 
            position: relative; 
            display: flex; 
            align-items: flex-end; 
            gap: 8px;
        }
        .message.left {
            align-self: flex-start;
            margin-right: 40px;
        }
        .message.right {
            align-self: flex-end;
            margin-left: 40px;
            flex-direction: row-reverse;
        }
        .message.left .text {
            background: linear-gradient(135deg, rgba(230, 244, 250, 0.95) 0%, rgba(220, 240, 255, 0.95) 100%);
            border-bottom-left-radius: 4px;
            border-bottom-right-radius: 16px;
            color: #2d3a4e;
            border-bottom: 2px solid #2d5016;
            box-shadow: 0 2px 8px rgba(135, 176, 206, 0.15);
            position: relative;
            overflow: hidden;
            padding: 10px 15px;
            border-radius: 10px;
            max-width: 80%;
            word-wrap: break-word;
        }
        .message.right .text {
            background: linear-gradient(135deg, rgba(180, 220, 245, 0.95) 0%, rgba(160, 210, 245, 0.95) 100%);
            border-bottom-left-radius: 16px;
            border-bottom-right-radius: 4px;
            color: #1a3a4e;
            box-shadow: 0 2px 8px rgba(100, 160, 200, 0.25);
            border-top: 2px solid rgba(255, 255, 255, 0.5);
            position: relative;
            overflow: hidden;
            padding: 10px 15px;
            border-radius: 10px;
            max-width: 80%;
            word-wrap: break-word;
        }
        @keyframes slideIn { 
            from { opacity: 0; transform: translateY(10px); } 
            to { opacity: 1; transform: translateY(0); } 
        }
        .message .user { 
            font-size: 14px; 
            display: block; 
            margin-bottom: 5px; 
        }
        .message.left .user {
            color: #2d5046;
            font-weight: 700;
        }
        .message.right .user {
            color: rgba(255, 255, 255, 0.9);
            font-weight: 600;
            text-align: right;
        }
        .message .user.admin { color: #2d5016; font-weight: bold; font-style: italic; }
        .message .user.system { color: #999; font-style: italic; }
        .message .time {
            font-size: 11px;
            opacity: 0.7;
            margin-top: 4px;
        }
        .message.right .time {
            text-align: right;
        }
        .message-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 14px;
            margin-right: 8px;
            flex-shrink: 0;
        }
        .message.right .message-avatar {
            display: none;
        }
        .message-content {
            display: flex;
            flex-direction: column;
            max-width: 70%;
        }
        .message.left .message-content {
            align-items: flex-start;
        }
        .message.right .message-content {
            align-items: flex-end;
        }
        .message img { 
            max-width: 100%; 
            max-height: 300px; 
            border-radius: 10px; 
            margin-top: 5px; 
            cursor: pointer; 
        }
        .message .file-link { 
            display: block; 
            margin-top: 5px; 
            padding: 10px 15px; 
            background: rgba(255,255,255,0.2); 
            border-radius: 8px; 
            color: inherit; 
            text-decoration: none; 
        }
        .system { 
            text-align: center; 
            color: #999; 
            font-style: italic; 
            font-size: 14px; 
            margin: 10px 0; 
        }
        .input-area { 
            padding: 12px 15px; 
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(20px);
            border-top: 1px solid rgba(45, 80, 22, 0.15);
            display: flex; 
            align-items: center; 
            gap: 10px; 
            flex-shrink: 0; 
        }
        .input-wrapper { 
            flex: 1; 
            display: flex; 
            align-items: center; 
            background: rgba(255, 255, 255, 0.7);
            border-radius: 25px; 
            padding: 8px 15px; 
            gap: 10px; 
            box-shadow: inset 2px 2px 6px rgba(0, 0, 0, 0.05), inset -2px -2px 6px rgba(255, 255, 255, 0.9);
        }
        .attach-btn { 
            background: none; 
            border: none; 
            font-size: 24px; 
            color: #888; 
            cursor: pointer; 
            padding: 5px; 
        }
        .message-input { 
            flex: 1; 
            border: none; 
            background: transparent; 
            font-size: 16px; 
            outline: none; 
            padding: 5px 0; 
            color: #2d5016;
        }
        .message-input::placeholder { color: #999; }
        .emoji-btn { 
            background: none; 
            border: none; 
            font-size: 26px; 
            cursor: pointer; 
            padding: 5px; 
        }
        .send-btn { 
            width: 45px; 
            height: 45px; 
            border-radius: 50%; 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
            border: none; 
            color: white; 
            font-size: 20px; 
            cursor: pointer; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            transition: all 0.3s ease; 
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.3); 
        }
        .send-btn:hover { 
            transform: scale(1.1); 
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4); 
        }
        .emoji-picker { 
            position: absolute; 
            bottom: 80px; 
            right: 60px; 
            width: 320px; 
            height: 320px; 
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 16px; 
            padding: 10px; 
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            overflow-y: auto; 
            z-index: 1000; 
            opacity: 0; 
            visibility: hidden; 
            transform: translateY(20px) scale(0.9); 
            transition: all 0.3s ease; 
        }
        .emoji-picker.show { 
            display: grid; 
            grid-template-columns: repeat(6, 1fr); 
            gap: 8px; 
            opacity: 1; 
            visibility: visible; 
            transform: translateY(0) scale(1); 
        }
        .emoji-picker span { 
            font-size: 28px; 
            cursor: pointer; 
            padding: 8px; 
            text-align: center; 
            border-radius: 8px; 
        }
        .emoji-picker span:hover { 
            background: #f0f0f0; 
            transform: scale(1.2); 
        }
        .status { 
            position: fixed; 
            top: 15px; 
            right: 20px; 
            font-size: 22px; 
            z-index: 1000; 
        }
        .status.connected { color: #4caf50; }
        .status.disconnected { color: #f44336; }
        /* ТЁМНАЯ ТЕМА */
        body.dark-theme {
            --bg-gradient: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            --container-bg: rgba(30, 30, 46, 0.95);
        }
        body.dark-theme .container {
            background: rgba(30, 30, 46, 0.95);
        }
        body.dark-theme .header {
            background: rgba(30, 30, 46, 0.7);
            border-bottom-color: rgba(74, 124, 46, 0.3);
        }
        body.dark-theme .header-text {
            background: linear-gradient(135deg, #4a7c2e 0%, #6ba34e 50%, #4a7c2e 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        body.dark-theme .login-screen h2 {
            color: #e0e0e0;
        }
        body.dark-theme .login-screen p {
            color: #888;
        }
        body.dark-theme .login-screen input {
            background: rgba(30, 30, 46, 0.8);
            border-color: #444;
            color: #e0e0e0;
        }
        body.dark-theme .users-panel {
            background: rgba(30, 30, 46, 0.6);
            border-right-color: #444;
        }
        body.dark-theme .user-item {
            background: rgba(45, 45, 68, 0.8);
            color: #e0e0e0;
        }
        body.dark-theme .message.left .text {
            background: linear-gradient(135deg, rgba(45, 55, 72, 0.95) 0%, rgba(35, 45, 62, 0.95) 100%);
            color: #c0d0e0;
            border-bottom-color: #4a7c2e;
        }
        body.dark-theme .message.right .text {
            background: linear-gradient(135deg, rgba(70, 90, 110, 0.95) 0%, rgba(60, 80, 100, 0.95) 100%);
            color: #e0e8f0;
            border-top-color: rgba(255, 255, 255, 0.2);
        }
        .input-area { 
            padding: 12px 15px; 
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(20px);
            border-top: 1px solid rgba(45, 80, 22, 0.15);
            display: flex; 
            align-items: center; 
            gap: 10px; 
            flex-shrink: 0; 
        }
        body.dark-theme .input-wrapper {
            background: rgba(45, 45, 68, 0.8);
        }
        body.dark-theme .message-input {
            color: #e0e0e0;
        }
        body.dark-theme .message-input::placeholder {
            color: #666;
        }
        /* КОНТЕКСТНОЕ МЕНЮ */
        .context-menu {
            position: absolute;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(15px);
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.5);
            z-index: 1000;
            min-width: 150px;
            padding: 8px 0;
            display: none;
        }
        .context-menu.show {
            display: block;
        }
        .context-menu-item {
            padding: 10px 20px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s ease;
        }
        .context-menu-item:hover {
            background: rgba(45, 80, 22, 0.1);
        }
        .context-menu-item.delete {
            color: #f44336;
        }
        .context-menu-item.pin {
            color: #2d5016;
        }
        body.dark-theme .context-menu {
            background: rgba(30, 30, 46, 0.95);
            border-color: #444;
        }
        body.dark-theme .context-menu-item:hover {
            background: rgba(74, 124, 46, 0.2);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <span class="header-text">🌭 DatCha</span>
            <button class="logout-btn" id="logoutBtn" onclick="logout()">Выйти</button>
            <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()">🌙</button>
        </div>
        <div class="login-screen" id="loginScreen">
            <h2>Вход в чат</h2>
            <p>Введите ваш ник и пароль</p>
            <input type="text" id="nicknameInput" placeholder="#твой ник" maxlength="20" onkeypress="if(event.key==='Enter')joinChat()">
            <input type="password" id="passwordInput" placeholder="Пароль" maxlength="30" onkeypress="if(event.key==='Enter')joinChat()">
            <button onclick="joinChat()">Регистрация / Вход</button>
            <button onclick="resetData()" style="margin-top: 10px; background: #f44336;">🔄 Сбросить данные</button>
        </div>
        <div class="main" id="mainContent" style="display: none;">
            <div class="users-panel">
                <h3>Онлайн (<span id="userCount">0</span>)</h3>
                <div id="usersList"></div>
            </div>
            <div style="display: flex; flex-direction: column; flex: 1; overflow: hidden;">
                <div class="messages" id="messages"></div>
                <div class="input-area" id="inputArea">
                    <div class="input-wrapper">
                        <button class="attach-btn" onclick="document.getElementById('fileInput').click()">+</button>
                        <input type="text" class="message-input" id="messageInput" placeholder="Сообщение" onkeypress="if(event.key==='Enter')sendMessage()">
                    </div>
                    <div class="right-controls">
                        <button class="emoji-btn" onclick="toggleEmoji()">😊</button>
                        <button class="send-btn" onclick="sendMessage()">➤</button>
                    </div>
                    <input type="file" id="fileInput" style="display: none;" onchange="uploadFile(this.files[0])" accept="image/*,.pdf,.doc,.docx,.txt">
                </div>
            </div>
        </div>
    </div>
    <div class="emoji-picker" id="emojiPicker">
        <span>😀</span><span>😃</span><span>😄</span><span>😁</span><span>😆</span><span>😅</span>
        <span>🤣</span><span>😊</span><span>🙂</span><span></span><span>😉</span><span>😊</span>
        <span>😍</span><span>🥰</span><span>😘</span><span>😗</span><span>😚</span><span>😙</span>
        <span>😋</span><span>😛</span><span>😜</span><span>🤪</span><span>😝</span><span>🤗</span>
        <span>🤭</span><span>🤫</span><span>🤔</span><span>🤐</span><span>🤨</span><span>😐</span>
        <span></span><span>😶</span><span>😏</span><span>😒</span><span>🙄</span><span></span>
        <span>🤥</span><span>😌</span><span>😔</span><span>😪</span><span>🤤</span><span>😴</span>
        <span>😷</span><span>🤒</span><span>🤕</span><span>🤢</span><span>🤮</span><span>🤧</span>
        <span>😵</span><span>🤯</span><span>🤠</span><span>🥳</span><span></span><span>🤓</span>
        <span>🧐</span><span>😕</span><span>😟</span><span>🙁</span><span></span><span>😯</span>
        <span>😲</span><span></span><span>🥺</span><span>😦</span><span>😧</span><span>😨</span>
        <span>😰</span><span>😥</span><span>😢</span><span>😭</span><span>😱</span><span>😖</span>
        <span>😣</span><span>😞</span><span>😓</span><span>😩</span><span>😫</span><span>🥱</span>
        <span>😤</span><span>😡</span><span>😠</span><span></span><span>😈</span><span>👿</span>
        <span>💀</span><span>☠️</span><span>💩</span><span></span><span>👹</span><span>👺</span>
        <span>❤️</span><span></span><span>💛</span><span>💚</span><span>💙</span><span>💜</span>
        <span>🖤</span><span>🤍</span><span></span><span>💔</span><span>❣️</span><span>💕</span>
        <span>💞</span><span>💓</span><span>💗</span><span>💖</span><span>💘</span><span>💝</span>
        <span>👍</span><span>👎</span><span></span><span>✌️</span><span>🤞</span><span></span>
        <span></span><span>🤙</span><span>👈</span><span></span><span>👆</span><span>👇</span>
        <span>👏</span><span>🙌</span><span>👐</span><span>🤝</span><span>🙏</span><span>✍️</span>
        <span>💪</span><span>🐶</span><span></span><span>🐭</span><span>🐹</span><span></span>
        <span>🦊</span><span>🐻</span><span>🐼</span><span>🐨</span><span>🐯</span><span>🦁</span>
        <span>🐮</span><span>🐷</span><span>🐸</span><span>🐵</span><span>🐔</span><span>🐧</span>
        <span>🐦</span><span>🍎</span><span>🍐</span><span>🍊</span><span>🍋</span><span>🍌</span>
        <span>🍉</span><span>🍇</span><span>🍓</span><span>🫐</span><span>🍈</span><span>🍒</span>
        <span>🍑</span><span>🥭</span><span>🍍</span><span>🥥</span><span>🥝</span><span>🍅</span>
        <span></span><span>🥑</span><span>🥦</span><span>🥬</span><span>🥒</span><span>🌶️</span>
        <span>🌽</span><span>🥕</span><span></span><span>🧄</span><span>🧅</span><span></span>
        <span>⚽</span><span>🏀</span><span>🏈</span><span>⚾</span><span>🥎</span><span>🎾</span>
        <span>🏐</span><span>🏉</span><span>🎱</span><span>🏓</span><span></span><span>🥅</span>
        <span></span><span></span><span>🎣</span><span>🥊</span><span></span><span>🎽</span>
        <span>🛹</span><span>🛼</span><span></span><span>⛸️</span><span>🥌</span><span>🎿</span>
        <span>💻</span><span>🖥️</span><span>⌨️</span><span>🖱️</span><span></span><span>💿</span>
        <span>📱</span><span>📲</span><span>📷</span><span>📸</span><span>📹</span><span>🎥</span>
        <span>🎬</span><span>🎤</span><span>🎧</span><span>📻</span><span>🎮</span><span>🕹️</span>
        <span>🎲</span><span>🧩</span><span>🎳</span><span>🎨</span><span></span><span>🎪</span>
        <span>🚗</span><span>🚕</span><span>🚙</span><span>🚌</span><span>🚎</span><span>🏎️</span>
        <span>🚓</span><span>🚑</span><span>🚒</span><span>🚐</span><span>🛻</span><span>🚚</span>
        <span></span><span>🚜</span><span>🛴</span><span></span><span>🛵</span><span>🏍️</span>
        <span>✈️</span><span></span><span>🛸</span><span>🚁</span><span></span><span>⛵</span>
        <span></span><span>🏠</span><span>🏡</span><span>🏢</span><span>🏣</span><span>🏤</span>
        <span>🏥</span><span>🏦</span><span>🏨</span><span>🏩</span><span>🏪</span><span></span>
        <span></span><span>💮</span><span>🏵️</span><span>🌹</span><span>🥀</span><span>🌺</span>
        <span>🌻</span><span>🌼</span><span>🌷</span><span>🌱</span><span>🪴</span><span></span>
        <span>🌳</span><span>🌴</span><span>🌵</span><span></span><span>🌿</span><span>☘️</span>
        <span>🍀</span><span>🍁</span><span>🍂</span><span>🍃</span><span></span><span>🌍</span>
        <span>🌎</span><span>🌏</span><span>🌕</span><span>🌖</span><span>🌗</span><span>🌘</span>
        <span>🌑</span><span>🌒</span><span>🌓</span><span>🌔</span><span>☀️</span><span>🌝</span>
        <span>🌞</span><span>⭐</span><span>🌟</span><span>🌠</span><span>☁️</span><span></span>
        <span>⛈️</span><span>️</span><span>🌥️</span><span>🌦️</span><span>🌧️</span><span>🌨️</span>
        <span>️</span><span>️</span><span>️</span><span>🌬️</span><span>🌈</span><span>☔</span>
        <span>⚡</span><span>️</span><span>☃️</span><span>⛄</span><span>🔥</span><span>💧</span>
        <span>🌊</span><span>🎄</span><span>✨</span><span>🎋</span><span>🎍</span><span>🎎</span>
        <span>🎏</span><span>🎐</span><span>🎑</span><span>🧧</span><span></span><span>🎁</span>
        <span>🎗️</span><span>🎟️</span><span></span><span>🎖️</span><span>🏆</span><span>🏅</span>
        <span>🥇</span><span>🥈</span><span>🥉</span><span>⚽</span><span>🏀</span><span></span>
    </div>
    <div class="status disconnected" id="status"></div>

    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chat", { transport: signalR.HttpTransportType.LongPolling | signalR.HttpTransportType.WebSockets })
            .withAutomaticReconnect([0, 2000, 5000, 10000, 15000, 30000, 60000])
            .build();

        let currentNickname = '';
let contextMenuMessageId = null;
        let loginSuccess = false;
        let isConnecting = false;

        connection.on("ReceiveMessage", (msg) => { addMessage(msg); });
        connection.on("MessageDeleted", (msg) => {
            const msgElement = document.querySelector(`[data-message-id="${msg.Id}"]`);
            if (msgElement) {
                msgElement.style.transition = 'all 0.5s ease';
                msgElement.style.opacity = '0';
                msgElement.style.transform = 'translateX(20px)';
                setTimeout(() => msgElement.remove(), 500);
            }
        });
        connection.on("UserJoined", (user) => { addSystemMessage(user + ' присоединился'); });
        connection.on("UserLeft", (user) => { addSystemMessage(user + ' отключился'); });
        connection.on("UpdateUsers", (users) => {
            const list = document.getElementById('usersList');
            list.innerHTML = '';
            users.forEach(u => {
                const div = document.createElement('div');
                div.className = 'user-item';
                div.textContent = u;
                list.appendChild(div);
            });
            document.getElementById('userCount').textContent = users.length;
        });
        connection.on("LoginError", (msg) => { alert("Ошибка: " + msg); showLoginScreen(); });
        connection.on("LoginSuccess", (data) => {
            localStorage.setItem('familyChatToken', data.SessionToken);
            localStorage.setItem('familyChatNickname', '#' + data.Nickname);
            loginSuccess = true;
        });
        connection.on("LoadHistory", (messages) => { messages.forEach(msg => addMessage(msg)); });
        connection.on("ForceLogout", (reason) => { alert(reason); logout(); });
        
        connection.onreconnecting((error) => {
            console.log("🔄 Попытка переподключения...");
            document.getElementById('status').textContent = 'Переподключение...';
            document.getElementById('status').className = 'status disconnected';
        });
        connection.onreconnected((connectionId) => {
            console.log("✅ Связь восстановлена!");
            document.getElementById('status').textContent = '🟢 В сети';
            document.getElementById('status').className = 'status connected';
        });
        connection.onclose((error) => {
            console.warn("⚠️ Связь потеряна.");
            document.getElementById('status').textContent = 'Отключено';
            document.getElementById('status').className = 'status disconnected';
        });

        function showLoginScreen() {
            loginSuccess = false;
            isConnecting = false;
            document.getElementById('loginScreen').style.display = 'flex';
            document.getElementById('mainContent').style.display = 'none';
            document.getElementById('logoutBtn').classList.remove('show');
        }

        function showChatScreen() {
            loginSuccess = true;
            isConnecting = false;
            document.getElementById('loginScreen').style.display = 'none';
            document.getElementById('mainContent').style.display = 'flex';
            document.getElementById('logoutBtn').classList.add('show');
            document.getElementById('status').className = 'status connected';
        }

        async function ensureConnected() {
            if (connection.state === signalR.HubConnectionState.Connected) return;
            if (connection.state === signalR.HubConnectionState.Connecting || isConnecting) {
                await new Promise(resolve => setTimeout(resolve, 1000));
                return;
            }
            isConnecting = true;
            try {
                await connection.start();
            } catch (err) {
                isConnecting = false;
                throw err;
            }
        }

        async function joinChat() {
            let nick = document.getElementById('nicknameInput').value.trim();
            let pass = document.getElementById('passwordInput').value.trim();
            if (!nick) { alert("Введите ник!"); return; }
            if (!pass) { alert("Введите пароль!"); return; }
            if (!nick.startsWith('#')) nick = '#' + nick;
            currentNickname = nick;

            try {
                document.getElementById('status').textContent = 'Подключение...';
                await ensureConnected();
                await connection.invoke("RegisterOrLogin", nick, pass);
                showChatScreen();
            } catch (err) {
                console.error(err);
                alert("Ошибка входа: " + (err.message || err));
                showLoginScreen();
            }
        }

        async function autoLogin() {
            const savedNickname = localStorage.getItem('familyChatNickname');
            const savedToken = localStorage.getItem('familyChatToken');
            if (!savedNickname || !savedToken) return false;
            try {
                currentNickname = savedNickname;
                await ensureConnected();
                await connection.invoke("JoinByToken", savedNickname, savedToken);
                loginSuccess = true;
                showChatScreen();
                return true;
            } catch (err) {
                console.error('❌ Авто-вход не удался:', err);
                localStorage.removeItem('familyChatToken');
                localStorage.removeItem('familyChatNickname');
                showLoginScreen();
                return false;
            }
        }

        function resetData() {
            if (confirm("Сбросить все данные?")) {
                localStorage.clear();
                location.reload();
            }
        }

        function logout() {
            localStorage.removeItem('familyChatNickname');
            localStorage.removeItem('familyChatToken');
            currentNickname = '';
            loginSuccess = false;
            connection.stop();
            location.reload();
        }

        async function sendMessage() {
            if (!loginSuccess) { alert("Сначала войдите в чат!"); return; }
            const input = document.getElementById('messageInput');
            const text = input.value.trim();
            if (text) {
                await connection.invoke("SendMessage", text);
                input.value = '';
            }
        }

        async function uploadFile(file) {
            if (!file || !loginSuccess) return;
            if (file.size > 10 * 1024 * 1024) {
                alert("Файл слишком большой! Максимум 10MB");
                return;
            }
            try {
                const formData = new FormData();
                formData.append("file", file);
                const response = await fetch("/upload", { method: "POST", body: formData });
                if (response.ok) {
                    const data = await response.json();
                    await connection.invoke("SendFile", file.name, data.fileUrl, data.fileType);
                } else {
                    alert("Ошибка загрузки файла");
                }
            } catch (err) {
                console.error("Ошибка загрузки:", err);
                alert("Не удалось загрузить файл");
            }
        }

        document.getElementById('emojiPicker').addEventListener('click', (e) => {
            if (e.target.tagName === 'SPAN') {
                const emoji = e.target.textContent;
                const input = document.getElementById('messageInput');
                input.value += emoji;
                input.focus();
            }
        });

        document.addEventListener('click', (e) => {
            if (!e.target.closest('.emoji-btn') && !e.target.closest('.emoji-picker')) {
                document.getElementById('emojiPicker').classList.remove('show');
            }
        });

        function toggleEmoji() { 
            document.getElementById('emojiPicker').classList.toggle('show'); 
        }

        function toggleTheme() {
            document.body.classList.toggle('dark-theme');
            const isDark = document.body.classList.contains('dark-theme');
            localStorage.setItem('familyChatTheme', isDark ? 'dark' : 'light');
            document.getElementById('themeToggle').textContent = isDark ? '☀️' : '🌙';
        }

        function addMessage(msg) {
            const div = document.createElement('div');
            div.className = 'message';
            
            // Добавляем правый клик для контекстного меню
            div.addEventListener('contextmenu', (e) => {
                e.preventDefault();
                contextMenuMessageId = msg.Id;
                const menu = document.getElementById('contextMenu');
                menu.style.left = e.pageX + 'px';
                menu.style.top = e.pageY + 'px';
                menu.classList.add('show');
            });
            
            let userName = msg.Nickname || msg.nickname || msg.User || msg.user || 'unknown';
            let text = msg.Text || msg.text || '';
            let fileUrl = msg.FileUrl || msg.fileUrl;
            let fileType = msg.FileType || msg.fileType;
            let messageId = msg.Id;
            let time = new Date().toLocaleTimeString('ru-RU', {hour: '2-digit', minute:'2-digit'});
            
            if (messageId) div.dataset.messageId = messageId;
            
            const myNick = (currentNickname || localStorage.getItem('familyChatNickname') || '').replace('#', '');
            let positionClass = 'left';
            if (userName === 'Система') {
                div.style.textAlign = 'center';
                div.style.width = '100%';
            } else if (userName === myNick || userName === '#' + myNick) {
                positionClass = 'right';
            }
            div.classList.add(positionClass);
            
            let messageHTML = '';
            
            if (positionClass === 'left' && userName !== 'Система') {
                const firstLetter = userName.charAt(0).toUpperCase();
                messageHTML += `<div class="message-avatar">${firstLetter}</div>`;
            }
            
            messageHTML += `<div class="message-content">`;
            
            if (positionClass !== 'right' && userName !== 'Система') {
                let userClass = 'user regular';
                if (userName === 'Админ' || userName === '#Админ') userClass = 'user admin';
                messageHTML += `<span class="${userClass}">${userName}</span>`;
            }
            
            if (fileUrl) {
                if (fileType === 'image') {
                    messageHTML += `<div class="text"><img src="${fileUrl}" alt="${text}" onclick="window.open('${fileUrl}', '_blank')" style="max-width: 100%; border-radius: 8px;"></div>`;
                } else {
                    messageHTML += `<a href="${fileUrl}" class="file-link" download>📎 ${text}</a>`;
                }
            } else {
                messageHTML += `<div class="text">${text}</div>`;
            }
            
            messageHTML += `<div class="time">${time}</div>`;
            messageHTML += `</div>`;
            
            div.innerHTML = messageHTML;
            const messages = document.getElementById('messages');
            messages.appendChild(div);
            messages.scrollTop = messages.scrollHeight;
        }

        function addSystemMessage(text) {
            const div = document.createElement('div');
            div.className = 'system';
            div.textContent = text;
            document.getElementById('messages').appendChild(div);
        }

        async function deleteMessage() {
            if (contextMenuMessageId) {
                await connection.invoke("DeleteMessage", contextMenuMessageId);
                hideContextMenu();
            }
        }

        async function pinMessage() {
            if (contextMenuMessageId) {
                await connection.invoke("PinMessage", contextMenuMessageId);
                hideContextMenu();
            }
        }

        function hideContextMenu() {
            const menu = document.getElementById('contextMenu');
            menu.classList.remove('show');
            contextMenuMessageId = null;
        }

        // Скрываем меню при клике вне его
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.context-menu')) {
                hideContextMenu();
            }
        });

        window.addEventListener('load', async () => {
            await autoLogin();
        });
    </script>
    <div class="context-menu" id="contextMenu">
        <div class="context-menu-item pin" onclick="pinMessage()">📌 Закрепить</div>
        <div class="context-menu-item delete" onclick="deleteMessage()">🗑️ Удалить</div>
    </div>
</body>
</html>
