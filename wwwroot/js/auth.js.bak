window.sessionToken = localStorage.getItem("sessionToken") || null;

async function login() {

    const nickname =
        document.getElementById("nicknameInput").value.trim();

    const password =
        document.getElementById("passwordInput").value.trim();

    if (!nickname || !password) {
        alert("Введите ник и пароль");
        return;
    }

    try {

        const result =
            await connection.invoke(
                "RegisterOrLogin",
                nickname,
                password
            );

        if (!result.success) {
            alert(result.message || "Ошибка входа");
            return;
        }


        window.sessionToken = result.sessionToken;

        localStorage.setItem(
            "sessionToken",
            result.sessionToken
        );

        showChat();

            nickname;

    }
    catch (e) {

        console.error(e);

        alert("Ошибка подключения");

    }

}

async function loginByToken() {
    return false;
}

function logout() {

    localStorage.removeItem("sessionToken");

    window.sessionToken = null;


    showLogin();

}

document
    .getElementById("loginBtn")
    ?.addEventListener("click", login);

document
    .getElementById("logoutBtn")
    ?.addEventListener("click", logout);

document
    .getElementById("passwordInput")
    ?.addEventListener("keydown", e => {

        if (e.key === "Enter")
            login();

    });
